# Konfiguracja aplikacji
PORT=5414
APP_URL=https://io-brew.piwo.org

# Sekret JWT (wymagany) - wygeneruj np.: openssl rand -hex 32
JWT_SECRET=

# Konfiguracja SMTP (wymagane)
SMTP_HOST=mail18.mydevil.net
SMTP_PORT=587
SMTP_USER=io-brew@piwo.org
SMTP_PASSWORD=
SMTP_FROM=io-brew@piwo.org

# Google OAuth (opcjonalne)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Piwo.org OAuth
PIWO_OAUTH_CLIENT_ID=
PIWO_OAUTH_CLIENT_SECRET=
PIWO_OAUTH_AUTH_URL=https://piwo.org/oauth/authorize/
PIWO_OAUTH_TOKEN_URL=https://piwo.org/oauth/token/
PIWO_OAUTH_CALLBACK_URL=https://io-brew.piwo.org/auth/piwo/callback

# Parametry urządzeń
IO_BREW_MIN_INTERVAL=900
IO_BREW_INACTIVITY_TIMEOUT=6
